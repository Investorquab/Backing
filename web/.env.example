# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the deployed site, no trailing slash. Base App cards, the manifest and share links use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WalletConnect Cloud project id (https://cloud.reown.com). Enables the WalletConnect sign-in option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: your own RPC URLs (Alchemy / QuickNode / Coinbase CDP). Public RPCs work but rate-limit.
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# Display name of the real vault you wire on mainnet, e.g. "Steakhouse USDC (Morpho)"
NEXT_PUBLIC_VAULT_NAME=

# Yearly rate used for "a month" estimates on the testnet demo, and as a fallback on mainnet (0.05 = 5%)
NEXT_PUBLIC_FALLBACK_APY=0.05

# Show the "Local" network in a production build (it always shows in `npm run dev`)
NEXT_PUBLIC_SHOW_LOCAL=false

# Farcaster integration (Discover search, verified profiles, imported casts). Free key from neynar.com.
# Server-side only — never prefix with NEXT_PUBLIC. Without it, Farcaster features return 503.
NEYNAR_API_KEY=

# Picture uploads: create a Blob store in your Vercel project (Storage → Create → Blob) and connect it.
# Vercel sets this for you. Locally, leave it empty and pictures are saved to public/uploads.
BLOB_READ_WRITE_TOKEN=

# Hosts whose pictures the site will show (comma separated). Your own site is always allowed.
NEXT_PUBLIC_IMAGE_HOSTS=public.blob.vercel-storage.com

# Comma-separated wallet addresses to hide from the site (profiles, posts, backings).
# On-chain posts can't be deleted, so this is how you moderate.
NEXT_PUBLIC_HIDDEN_ADDRESSES=

# --- Base App mini app (see README "Base App setup") ---
# The three values from signing your domain with your Base App / Farcaster account.
# They are public signatures, not secrets.
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
# Only if Base's current guide asks for it: the wallet address that owns your listing
BASE_BUILDER_OWNER=
# true while testing, so the app isn't listed in search yet
MINIAPP_NOINDEX=false
