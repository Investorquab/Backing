# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the deployed site (used for share links / OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WalletConnect Cloud project id (https://cloud.reown.com). Enables the WalletConnect option.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: your own RPC URLs (Alchemy / QuickNode / Coinbase CDP). Public RPCs work but rate-limit.
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# Display name of the real vault you wire on mainnet, e.g. "Steakhouse USDC (Morpho)"
NEXT_PUBLIC_VAULT_NAME=

# APY used for "est. per month" figures on the testnet demo, and as a fallback on mainnet (0.05 = 5%)
NEXT_PUBLIC_FALLBACK_APY=0.05

# Show the "Local" network in a production build (it always shows in `npm run dev`)
NEXT_PUBLIC_SHOW_LOCAL=false
